# Copy this file to .env and fill it in. NEVER share or commit .env
TELEGRAM_BOT_TOKEN=put-your-NEW-token-from-BotFather-here
TELEGRAM_ADMIN_ID=8399379960

MRCLIP_URL=https://mrclip.gr
# Leave empty and the bot finds the Submissions page from the menu by itself.
# Or paste the address of the Submissions page here.
SUBMISSIONS_URL=

# Clips with at least this many views are "ready to accept"
MIN_VIEWS=1000
# Click REFRESH STATS + check all pages every N hours
REFRESH_EVERY_HOURS=5
# Max minutes to wait for REFRESH STATS to finish (859 posts can take a while)
REFRESH_TIMEOUT_MIN=180

# true = hidden browser (normal). The login script always shows the window.
HEADLESS=true
# Use your installed Google Chrome instead of the bundled Chromium (helps Google login). Empty = bundled.
BROWSER_CHANNEL=chrome
