# Copy this file to .env and fill in your values. NEVER commit .env
TELEGRAM_BOT_TOKEN=put-your-NEW-token-from-BotFather-here
TELEGRAM_ADMIN_ID=8399379960

MRCLIP_URL=https://mrclip.gr
MRCLIP_USERNAME=your-mrclip-login
MRCLIP_PASSWORD=your-mrclip-password

# How often (minutes) to scan for new clips
CHECK_INTERVAL_MIN=10
# How often (minutes) to run the "refresh views" pass over all clips
REFRESH_INTERVAL_MIN=360
# Seconds to wait between clicks so the site isn't hammered (900 clips * 3s ~= 45 min)
CLICK_DELAY_SEC=3
# true = approve every new clip automatically; false = send you Approve/Reject buttons
AUTO_APPROVE=false
# Show the browser window (useful for debugging on your PC)
HEADLESS=true
